  "contract-tests-codec": {
   "file": "tests/test_contract_codec.py",
   "v1": "import json\n\nfrom swarm.contract.codec import to_json, from_json\nfrom swarm.contract.schema import UserMsg, JobMsg, EventMsg\n\n\ndef test_roundtrip_user():\n    m = UserMsg(\"u1\", \"Ada\", \"admin\")\n    assert from_json(to_json(m), UserMsg) == m\n\n\ndef test_roundtrip_job():\n    m = JobMsg(\"j1\", \"u1\", \"echo\", {\"text\": \"hi\"}, \"todo\")\n    assert from_json(to_json(m), JobMsg) == m\n\n\ndef test_roundtrip_event():\n    m = EventMsg(\"e1\", \"job.completed\", {\"job\": \"j1\"}, \"2026-01-01T00:00:00Z\")\n    assert from_json(to_json(m), EventMsg) == m\n\n\ndef test_canonical_sorted_keys():\n    m = UserMsg(\"u1\", \"Ada\", \"admin\")\n    obj = json.loads(to_json(m))\n    assert list(obj.keys()) == [\"id\", \"name\", \"role\"]\n\n\n# FAULT (v1, wrong-test lesson \u00a74.3): this asserts the WRONG contract. The\n# codec is lenient by default and IGNORES unknown fields; this test claims it\n# must REJECT them. The test (not the code) is wrong and must fail.\ndef test_lenient_ignores_unknown():\n    text = '{\"id\": \"u1\", \"name\": \"Ada\", \"role\": \"admin\", \"zzz\": 1}'\n    m = from_json(text, UserMsg)\n    assert m is None, \"lenient mode must reject unknown fields (WRONG ASSERTION)\"",
   "verify": [
    "pytest",
    "tests/test_contract_codec.py"
   ],
   "needs": [
    "tests/test_contract_codec.py"
   ],
   "title": "codec test asserts the real (lenient) contract",
   "acceptance": [
    "lenient decoding ignores unknown fields",
    "tests/test_contract_codec.py passes"
   ]
  },
  "storage-repo-jobs": {
   "file": "swarm/storage/jobs.py",
   "v1": "\"\"\"JobRepository \u2014 CRUD plus a claim() over the ``jobs`` table.\n\nNOTE (fault-injected v1, \u00a74.2 concurrency-race lesson): this variant SELECTs a\n``todo`` row but never flips it to ``running`` \u2014 so every worker that calls\nclaim() receives the SAME job. Only the canonical v2 transitions the row and\nmakes double-claim impossible. tests/review_atomicity.py must fail under this\nvariant (both connections claim ``j1`` -> double-claim).\n\"\"\"\nfrom __future__ import annotations\n\nimport sqlite3\nfrom typing import Any, Dict, Optional\n\nfrom ..util import utcnow_iso\n\n_COLS = (\n    \"id\", \"user_id\", \"kind\", \"payload\", \"status\",\n    \"attempts\", \"created_at\", \"updated_at\",\n)\n\n\nclass JobRepo:\n    \"\"\"Repo for the ``jobs`` table. Row dicts include ALL columns.\"\"\"\n\n    def __init__(self, conn: sqlite3.Connection):\n        self.conn = conn\n        self.conn.row_factory = sqlite3.Row\n\n    def create(self, job_id: str, user_id: str, kind: str, payload: str) -> Dict[str, Any]:\n        \"\"\"Insert a job. ``payload`` is the caller's JSON-encoded **string**.\"\"\"\n        now = utcnow_iso()\n        row = {\n            \"id\": job_id,\n            \"user_id\": user_id,\n            \"kind\": kind,\n            \"payload\": payload,\n            \"status\": \"todo\",\n            \"attempts\": 0,\n            \"created_at\": now,\n            \"updated_at\": now,\n        }\n        self.conn.execute(\n            \"INSERT INTO jobs (id, user_id, kind, payload, status, attempts,\"\n            \" created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)\",\n            tuple(row[k] for k in _COLS),\n        )\n        self.conn.commit()\n        return dict(row)\n\n    def get(self, job_id: str) -> Optional[Dict[str, Any]]:\n        \"\"\"Return the job row dict, or ``None`` when absent.\"\"\"\n        row = self.conn.execute(\n            \"SELECT * FROM jobs WHERE id = ?\", (job_id,)\n        ).fetchone()\n        return dict(row) if row is not None else None\n\n    def claim(self) -> Optional[Dict[str, Any]]:\n        \"\"\"Return the next ``todo`` job.\n\n        FAULT: the row is NOT transitioned to ``running``. Every caller gets\n        the same row again, so two connections both claim ``j1`` \u2014 a real\n        double-claim. The green v2 atomically UPDATEs to running instead.\n        \"\"\"\n        row = self.conn.execute(\n            \"SELECT * FROM jobs WHERE status = 'todo' ORDER BY rowid LIMIT 1\"\n        ).fetchone()\n        if row is None:\n            return None\n        return dict(row)  # status stays 'todo' \u2014 bug\n\n    def complete(self, job_id: str) -> None:\n        \"\"\"Mark the job done (status ``done``) and bump ``updated_at``.\"\"\"\n        now = utcnow_iso()\n        self.conn.execute(\n            \"UPDATE jobs SET status = 'done', updated_at = ? WHERE id = ?\",\n            (now, job_id),\n        )\n        self.conn.commit()\n\n    def fail(self, job_id: str, reason: str) -> None:\n        \"\"\"Mark the job failed: status ``failed``, attempts + 1, ``updated_at``.\"\"\"\n        now = utcnow_iso()\n        self.conn.execute(\n            \"UPDATE jobs SET status = 'failed', attempts = attempts + 1,\"\n            \" updated_at = ? WHERE id = ?\",\n            (now, job_id),\n        )\n        self.conn.commit()",
   "verify": [
    "pytest",
    "tests/test_review_atomicity.py"
   ],
   "needs": [
    "tests/test_review_atomicity.py"
   ],
   "title": "storage claim must be atomic (BEGIN IMMEDIATE / single txn)",
   "acceptance": [
    "a second connection must never claim the same job",
    "tests/test_review_atomicity.py passes"
   ]
  },
  "worker-exec": {
   "file": "swarm/worker/executor.py",
   "v1": "\"\"\"The job executor: poll -> dispatch -> complete/fail, with event logging.\n\nNOTE (fault-injected v1, PHASE2_DESIGN.md \u00a74.1 contract drift): the worker\nreads the payload column as if it were already a dict, but storage stores it\nas a JSON *string*. Calling handler(payload) with a str raises\nAttributeError, so jobs fail en masse. tests/review_execution.py must fail\nunder this variant.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport sqlite3\nimport uuid\nfrom typing import Any, Dict, Optional\n\nfrom ..storage.events import EventRepo\nfrom ..storage.jobs import JobRepo\nfrom ..util import utcnow_iso\nfrom .jobs import JOB_KINDS\nfrom .poll import next_ready_job\n\n\ndef _new_event_id() -> str:\n    return uuid.uuid4().hex\n\n\ndef _append_event(conn: sqlite3.Connection, type_: str, data: str) -> None:\n    EventRepo(conn).append(_new_event_id(), type_, data, utcnow_iso())\n\n\ndef run_once(conn: sqlite3.Connection,\n             job_fn: Optional[Dict[str, Any]] = None) -> Optional[str]:\n    \"\"\"Poll for one job and process it.\"\"\"\n    if job_fn is None:\n        job_fn = JOB_KINDS\n\n    row = next_ready_job(conn)\n    if row is None:\n        return None\n    job_id = row[\"id\"]\n    kind = row[\"kind\"]\n\n    # FAULT: payload comes from the column as a JSON string, but we pass it to\n    # the handler as-is (a str). handler[text] -> AttributeError.\n    payload: Any = row[\"payload\"]\n\n    handler = job_fn.get(kind)\n    if handler is None:\n        _fail(conn, row, f\"unknown job kind: {kind}\")\n        return job_id\n\n    try:\n        result = handler(payload)\n    except Exception as exc:\n        _fail(conn, row, f\"execution failed: {exc}\")\n        return job_id\n\n    JobRepo(conn).complete(job_id)\n    _append_event(conn, \"job.completed\",\n                  json.dumps({\"job_id\": job_id, \"kind\": kind,\n                              \"result\": result}, default=str))\n    return job_id\n\n\ndef _fail(conn: sqlite3.Connection, row: Dict[str, Any], reason: str) -> None:\n    job_id = row[\"id\"]\n    kind = row[\"kind\"]\n    JobRepo(conn).fail(job_id, reason)\n    _append_event(conn, \"job.failed\",\n                  json.dumps({\"job_id\": job_id, \"kind\": kind,\n                              \"reason\": reason}))",
   "verify": [
    "pytest",
    "tests/test_review_execution.py"
   ],
   "needs": [
    "tests/test_review_execution.py"
   ],
   "title": "worker decodes JSON-string payload before dispatch",
   "acceptance": [
    "payload is json.loads()ed before handler dispatch",
    "tests/test_review_execution.py passes"
   ]
  }
